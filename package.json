{
  "name": "decky-library-doctor",
  "version": "0.18.0",
  "description": "Library Doctor: clean non-Steam shortcuts, discover game EXEs, and safely delete DEL-collection games with path review.",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w"
  },
  "keywords": [
    "decky",
    "plugin",
    "steam-deck",
    "non-steam",
    "cleanup"
  ],
  "author": "nach",
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@rollup/rollup-linux-x64-musl": "^4.53.3",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/webpack": "^5.28.5",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nch0083/decky-library-doctor.git"
  },
  "homepage": "https://github.com/nch0083/decky-library-doctor",
  "bugs": {
    "url": "https://github.com/nch0083/decky-library-doctor/issues"
  }
}
